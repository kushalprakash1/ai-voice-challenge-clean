# Synthetic E.164 placeholder for dry runs.
# Replace with your actually authorized originating number before a live call.
VOICEPROBE_ORIGINATING_NUMBER=+12025550101

# Required for live calls. Leave empty for dry runs.
VOICEPROBE_DESTINATION_NUMBER=

# Dry-run mode is the safe default.
VOICEPROBE_DRY_RUN=true

# Required only when live Telnyx dialing is enabled.
VOICEPROBE_TELNYX_API_KEY=
VOICEPROBE_TELNYX_CONNECTION_ID=
